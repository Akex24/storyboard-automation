# API ключи и секреты
.env
.env.local

# Контент пользователя (у каждого свой)
output/
scenarios/
refs/
_inbox/
shows/
current_show.json
# actors/ — БОЛЬШЕ НЕ ИГНОРИРУЕТСЯ (с 2026-05-04). Админ управляет фото
# актёров (создание, удаление) и пушит их через SendUpdateThread.
# Коллеги получают через DownloadUpdateThread, который зеркалирует
# actors/ (удалит локально то, что админ удалил у себя). Сгенерированные
# character-рефы коллег живут в shows/*/refs/characters/<slug>/ — это
# их личная работа, в .gitignore (через `shows/`), не синкается.

