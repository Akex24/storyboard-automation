# API ключи и секреты
.env
.env.local
# Bridge-файл от Studio к pipeline.py (выбор провайдера картинок —
# narwhal / openai). У каждой машины свой выбор: админский выбор не
# должен перетирать выбор коллеги при `git pull`. Studio пересоздаёт
# файл при старте из локальной QSettings — поэтому отсутствие в репо
# безопасно. См. `sync_image_provider_to_project` в storyboard_app.py.
image_provider.txt

# Контент пользователя (у каждого свой)
output/
scenarios/
refs/
_inbox/
shows/
current_show.json
# actors/ — БОЛЬШЕ НЕ ИГНОРИРУЕТСЯ (с 2026-05-04). Админ управляет фото
# актёров (создание, удаление) и пушит их через SendUpdateThread.
# Коллеги получают через DownloadUpdateThread, который зеркалирует
# actors/ (удалит локально то, что админ удалил у себя). Сгенерированные
# character-рефы коллег живут в shows/*/refs/characters/<slug>/ — это
# их личная работа, в .gitignore (через `shows/`), не синкается.

# Сборка и кэш
build/
dist/
__pycache__/
*.pyc
*.pyo
*.spec.bak

